// IsleVendor core schema.
// Geometry columns (PostGIS) are declared Unsupported() because Prisma Client
// can't read/write them directly — all spatial reads/writes go through
// $queryRaw / $executeRaw (see src/modules/dispatch and src/modules/warehouse).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ─────────────────────────────────────────────────────────────────────────
// 0. ONBOARDING / KYC APPLICANT STATUS
// Shared across Warehouse, ResellerStore, Shop, and DriverProfile. Defaults
// to APPROVED on each model so the pre-existing "quick setup" dashboard
// forms (WarehouseSetupForm, StoreSetupForm, ShopSetupForm — which create a
// row for an already-authenticated user with no review step) keep behaving
// exactly as before. The new public onboarding endpoints (see
// modules/onboarding) explicitly set PENDING_REVIEW instead — that's the
// only thing that actually gates anything on this field today; there is no
// enforcement yet stopping a PENDING_REVIEW row from operating normally
// (listing products, accepting dispatches, etc.) — see onboarding.routes.ts
// for the admin approve/reject endpoints and the follow-up needed to
// actually gate access on this status.
// ─────────────────────────────────────────────────────────────────────────

enum ApplicantStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────────────────
// 1. USERS & ROLES
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  WAREHOUSE
  RESELLER
  // A small business selling its own items directly — no warehouse, no
  // approval step. Internally modeled as "Shop" (see below) to avoid
  // colliding with the already-pervasive "store" naming used by resellers;
  // user-facing text calls this role "Store".
  STORE
  DRIVER
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  phoneNumber  String   @map("phone_number")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  driverProfile  DriverProfile?
  warehouses     Warehouse[]
  resellerStore  ResellerStore?
  shops          Shop[]
  ledgerAccounts LedgerAccount[]

  ordersAsCustomer Order[]         @relation("OrderCustomer")
  ordersAsDriver   Order[]         @relation("OrderDriver")
  productRatings   ProductRating[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// 2. DRIVER KYC PROFILES
// ─────────────────────────────────────────────────────────────────────────

enum DriverVehicleType {
  MOTORCYCLE
  SEDAN
  CARGO_VAN
  BOX_TRUCK
}

enum DriverAvailability {
  FULL_TIME
  PART_TIME
  WEEKEND
}

enum PayoutMethod {
  BANK
  LYNK_WALLET
}

model DriverProfile {
  id               String                                @id @default(uuid()) @db.Uuid
  userId           String                                @unique @map("user_id") @db.Uuid
  // Nullable: nothing creates a DriverProfile yet except the new ISLE-104
  // onboarding endpoint, which only collects the license photo up front —
  // licenseNumber/licenseExpiry get OCR'd in later (still-stubbed) and the
  // selfie/liveness match is explicitly a later phase, see facial.py.
  licenseNumber    String?                               @map("license_number")
  licenseExpiry    DateTime?                             @map("license_expiry") @db.Date
  licenseImageUrl  String?                               @map("license_image_url")
  selfieImageUrl   String?                               @map("selfie_image_url")
  facialMatchScore Decimal?                              @map("facial_match_score") @db.Decimal(5, 2)
  isKycApproved    Boolean                               @default(false) @map("is_kyc_approved")
  isOnline         Boolean                               @default(false) @map("is_online")
  // Nullable: no fix until the driver's first heartbeat. Prisma Client can't
  // read/write this column — go through $queryRaw/$executeRaw (see
  // dispatch.gateway.ts and dispatch.routes.ts).
  currentLocation  Unsupported("geometry(Point, 4326)")? @map("current_location")
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz

  // ── ISLE-104: courier onboarding fields ──
  trn               String?             @map("trn")
  whatsappNumber    String?             @map("whatsapp_number")
  homeParish        String?             @map("home_parish")
  homeTown          String?             @map("home_town")
  vehicleType       DriverVehicleType?  @map("vehicle_type")
  vehicleMake       String?             @map("vehicle_make")
  vehicleModel      String?             @map("vehicle_model")
  vehicleYear       Int?                @map("vehicle_year")
  licensePlate      String?             @map("license_plate")
  hasColdBox        Boolean             @default(false) @map("has_cold_box")
  zoneParishes      String[]            @default([]) @map("zone_parishes")
  availability      DriverAvailability? @map("availability")
  payoutMethod      PayoutMethod?       @map("payout_method")
  bankName          String?             @map("bank_name")
  accountHolderName String?             @map("account_holder_name")
  accountNumber     String?             @map("account_number")
  branchCode        String?             @map("branch_code")
  lynkWalletId      String?             @map("lynk_wallet_id")
  insuranceCertUrl  String?             @map("insurance_cert_url")
  fitnessCertUrl    String?             @map("fitness_cert_url")
  slaAcceptedAt     DateTime?           @map("sla_accepted_at") @db.Timestamptz
  applicantStatus   ApplicantStatus     @default(PENDING_REVIEW) @map("applicant_status")
  // Public-facing "IV-DRV-XXXXXX" reference from the onboarding success
  // screen — nullable because drivers created before this field existed
  // (or seeded directly) never got one.
  referenceId       String?             @unique @map("reference_id")

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryApplications DeliveryApplication[]

  @@map("driver_profiles")
}

// ─────────────────────────────────────────────────────────────────────────
// 3. WAREHOUSES & MASTER SKUs
// ─────────────────────────────────────────────────────────────────────────

model Warehouse {
  id          String                               @id @default(uuid()) @db.Uuid
  userId      String                               @map("user_id") @db.Uuid
  name        String
  addressLine String                               @map("address_line")
  parish      String                               @default("Kingston")
  // Prisma Client can't read/write this column — go through $queryRaw/
  // $executeRaw (see warehouse.routes.ts, dispatch.routes.ts).
  location    Unsupported("geometry(Point, 4326)")

  // ── ISLE-101: warehouse hub onboarding fields ──
  legalBusinessName String?         @map("legal_business_name")
  trn               String?         @map("trn")
  gctNumber         String?         @map("gct_number")
  contactName       String?         @map("contact_name")
  contactPhone      String?         @map("contact_phone")
  contactEmail      String?         @map("contact_email")
  town              String?         @map("town")
  coverageParishes  String[]        @default([]) @map("coverage_parishes")
  storageSqFt       Int?            @map("storage_sq_ft")
  loadingBayCount   Int?            @map("loading_bay_count")
  operatingHours    String?         @map("operating_hours")
  storageTypes      String[]        @default([]) @map("storage_types")
  securityControls  String[]        @default([]) @map("security_controls")
  payoutMethod      PayoutMethod?   @map("payout_method")
  bankName          String?         @map("bank_name")
  accountHolderName String?         @map("account_holder_name")
  accountNumber     String?         @map("account_number")
  branchCode        String?         @map("branch_code")
  lynkWalletId      String?         @map("lynk_wallet_id")
  cocjDocUrl        String?         @map("cocj_doc_url")
  trnCardUrl        String?         @map("trn_card_url")
  proofOfAddressUrl String?         @map("proof_of_address_url")
  slaAcceptedAt     DateTime?       @map("sla_accepted_at") @db.Timestamptz
  // Existing WarehouseSetupForm (dashboard quick-setup) rows keep the
  // APPROVED default — see the ApplicantStatus doc comment above. The new
  // ISLE-105 onboarding endpoint explicitly overrides this to PENDING_REVIEW.
  applicantStatus   ApplicantStatus @default(APPROVED) @map("applicant_status")
  referenceId       String?         @unique @map("reference_id")

  // The warehouse's own call, not a platform-wide constant: what percentage
  // of their (post-discount) wholesale price a reseller earns for selling
  // an item — added on top of the wholesale price to form the customer's
  // retail price, alongside the platform's flat cut (see lib/pricing.ts).
  // Surfaced to prospective resellers via this warehouse's Vacancy postings
  // (see below).
  resellerCommissionPercent Int @default(20) @map("reseller_commission_percent")

  user                 User                    @relation(fields: [userId], references: [id])
  products             MasterProduct[]
  orders               Order[]
  authorizations       ResellerAuthorization[]
  deliveryApplications DeliveryApplication[]
  vacancies            Vacancy[]

  @@map("warehouses")
}

// ─────────────────────────────────────────────────────────────────────────
// 3b. RESELLER VACANCIES
// A warehouse's "we're recruiting" posting — what they're looking for in a
// reseller. A warehouse can run several at once (e.g. one for social-media
// sellers, another for retail partners). Only ACTIVE vacancies are surfaced
// on the reseller-side Applications page (see warehouse.routes.ts's GET
// /vacancies) — a warehouse with no active vacancy simply doesn't appear
// there; applying still goes through the existing ResellerAuthorization
// flow (authorization.routes.ts), a vacancy is discovery/marketing, not a
// separate application record.
// ─────────────────────────────────────────────────────────────────────────

model Vacancy {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  title       String
  description String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("vacancies")
}

enum ProductCondition {
  NEW
  USED
}

model MasterProduct {
  id                String   @id @default(uuid()) @db.Uuid
  warehouseId       String   @map("warehouse_id") @db.Uuid
  sku               String   @unique
  title             String
  description       String?
  category          String
  wholesalePriceJmd Decimal  @map("wholesale_price_jmd") @db.Decimal(12, 2)
  // The warehouse's own B2B discount off its wholesale price — see
  // lib/pricing.ts: since the reseller's and platform's cuts are both
  // computed as a percentage *of* this (post-discount) price, discounting
  // it lowers everyone's take, not just the warehouse's, and also lowers
  // what the customer ultimately pays.
  discountPercent   Int      @default(0) @map("discount_percent")
  condition         ProductCondition @default(NEW)
  // Free-text shown to customers on the product page — return policy,
  // warranty, care instructions, whatever's relevant. Deliberately one
  // flexible field rather than several narrow ones.
  productDetails    String?  @map("product_details")
  stockQuantity     Int      @default(0) @map("stock_quantity")
  // imageUrl is always images[0] — kept as its own column so every existing
  // read site (ProductCard, cart, etc.) can keep reading a single field
  // without knowing about the gallery. images[] holds the full gallery,
  // main photo included, for the product detail page.
  imageUrl          String?  @map("image_url")
  images            String[] @default([])
  // Suspended by the warehouse — hidden from the marketplace, but not
  // deleted (existing reseller listings and order history stay intact).
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  listings  StoreListing[]
  grants    ResellerProductGrant[]

  @@map("master_products")
}

// ─────────────────────────────────────────────────────────────────────────
// 4. RESELLER STOREFRONTS & LISTINGS
// ─────────────────────────────────────────────────────────────────────────

enum ResellerType {
  INDIVIDUAL_CREATOR
  REGISTERED_BUSINESS
}

enum SalesChannel {
  SOCIAL
  WHATSAPP
  WEBSITE
  POP_UP
}

model ResellerStore {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @unique @map("user_id") @db.Uuid
  storeName String @map("store_name")
  slug      String @unique

  // ── ISLE-102: reseller partner onboarding fields ──
  resellerType         ResellerType?   @map("reseller_type")
  legalName            String?         @map("legal_name")
  trn                  String?         @map("trn")
  contactPhone         String?         @map("contact_phone")
  parish               String?         @map("parish")
  instagramHandle      String?         @map("instagram_handle")
  tiktokHandle         String?         @map("tiktok_handle")
  primarySalesChannel  SalesChannel?   @map("primary_sales_channel")
  targetCategories     String[]        @default([]) @map("target_categories")
  // 1–100, enforced in the service layer (Decimal has no declarative CHECK
  // in Prisma) — see onboarding.routes.ts.
  defaultMarkupPercent Decimal?        @map("default_markup_percent") @db.Decimal(5, 2)
  payoutMethod         PayoutMethod?   @map("payout_method")
  bankName             String?         @map("bank_name")
  accountHolderName    String?         @map("account_holder_name")
  accountNumber        String?         @map("account_number")
  branchCode           String?         @map("branch_code")
  lynkWalletId         String?         @map("lynk_wallet_id")
  idDocUrl             String?         @map("id_doc_url")
  slaAcceptedAt        DateTime?       @map("sla_accepted_at") @db.Timestamptz
  // See Warehouse.applicantStatus for why this defaults to APPROVED —
  // same reasoning re: the existing StoreSetupForm quick-setup path.
  applicantStatus      ApplicantStatus @default(APPROVED) @map("applicant_status")
  referenceId          String?         @unique @map("reference_id")

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings       StoreListing[]
  orders         Order[]
  authorizations ResellerAuthorization[]
  productGrants  ResellerProductGrant[]

  @@map("reseller_stores")
}

// ─────────────────────────────────────────────────────────────────────────
// 4b. RESELLER STOCK AUTHORIZATION
// A reseller must be approved by a warehouse before they can list any of
// that warehouse's SKUs on their storefront (see commerce.routes.ts).
// ─────────────────────────────────────────────────────────────────────────

enum AuthorizationStatus {
  PENDING
  APPROVED
  // Temporarily revoked by the warehouse without losing the relationship
  // history or the reseller's item grants — distinct from REJECTED, which is
  // what a warehouse picks before ever approving someone.
  SUSPENDED
  REJECTED
}

model ResellerAuthorization {
  id          String              @id @default(uuid()) @db.Uuid
  storeId     String              @map("store_id") @db.Uuid
  warehouseId String              @map("warehouse_id") @db.Uuid
  status      AuthorizationStatus @default(PENDING)
  requestedAt DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  decidedAt   DateTime?           @map("decided_at") @db.Timestamptz

  store     ResellerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // A store can only have one active application per warehouse — re-applying
  // after a rejection updates this row rather than creating a new one.
  @@unique([storeId, warehouseId])
  @@map("reseller_authorizations")
}

// ─────────────────────────────────────────────────────────────────────────
// 4c. PER-ITEM RESELLER GRANTS
// Being APPROVED for a warehouse only means the relationship exists — a
// reseller can only list/sell a specific SKU once the warehouse has
// explicitly granted that item to their store (see commerce.routes.ts).
// ─────────────────────────────────────────────────────────────────────────

model ResellerProductGrant {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  masterProductId String   @map("master_product_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  store         ResellerStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct @relation(fields: [masterProductId], references: [id], onDelete: Cascade)

  @@unique([storeId, masterProductId])
  @@map("reseller_product_grants")
}

// ─────────────────────────────────────────────────────────────────────────
// 4d. SHOPS — small businesses selling their own stock directly
// Unlike a reseller (who needs warehouse approval + per-item grants) or a
// warehouse (bulk stock, sold through resellers), a Shop owns and sells its
// own limited catalog straight to customers — no approval layer at all.
// ─────────────────────────────────────────────────────────────────────────

enum VendorCategory {
  ARTISAN
  COTTAGE_FOOD
  RETAIL_BOUTIQUE
  AGRI_PROCESSOR
}

enum FulfillmentStrategy {
  SELF_DISPATCH
  HUB_CONSIGNMENT
  HYBRID
}

model Shop {
  id          String                               @id @default(uuid()) @db.Uuid
  userId      String                               @map("user_id") @db.Uuid
  shopName    String                               @map("shop_name")
  slug        String                               @unique
  addressLine String                               @map("address_line")
  parish      String                               @default("Kingston")
  // Needed for driver dispatch, same as a warehouse's location — Prisma
  // Client can't read/write this column, go through $queryRaw/$executeRaw.
  location    Unsupported("geometry(Point, 4326)")

  // ── ISLE-103: micro/small vendor fast-track onboarding fields ──
  vendorCategory         VendorCategory?      @map("vendor_category")
  // The catalog-wide category hint captured at signup (individual
  // ShopProduct rows carry their own, more specific category).
  primaryProductCategory String?              @map("primary_product_category")
  ownerName              String?              @map("owner_name")
  trn                    String?              @map("trn")
  whatsappNumber         String?              @map("whatsapp_number")
  estimatedItemCount     Int?                 @map("estimated_item_count")
  fulfillmentStrategy    FulfillmentStrategy? @map("fulfillment_strategy")
  // Only meaningful (and only collected) when fulfillmentStrategy is
  // SELF_DISPATCH — see onboarding.routes.ts / VendorOnboardingPage.jsx.
  pickupAddress          String?              @map("pickup_address")
  payoutMethod           PayoutMethod?        @map("payout_method")
  bankName               String?              @map("bank_name")
  accountHolderName      String?              @map("account_holder_name")
  accountNumber          String?              @map("account_number")
  branchCode             String?              @map("branch_code")
  lynkWalletId           String?              @map("lynk_wallet_id")
  govIdDocUrl            String?              @map("gov_id_doc_url")
  slaAcceptedAt          DateTime?            @map("sla_accepted_at") @db.Timestamptz
  // See Warehouse.applicantStatus — same "keep the quick-setup path
  // unaffected" reasoning re: ShopSetupForm. Fast-track review target is
  // 12–24 hrs, surfaced to the applicant, not enforced here.
  applicantStatus        ApplicantStatus      @default(APPROVED) @map("applicant_status")
  referenceId            String?              @unique @map("reference_id")

  user                 User                  @relation(fields: [userId], references: [id])
  products             ShopProduct[]
  orders               Order[]
  deliveryApplications DeliveryApplication[]

  @@map("shops")
}

model ShopProduct {
  id            String   @id @default(uuid()) @db.Uuid
  shopId        String   @map("shop_id") @db.Uuid
  sku           String   @unique
  title         String
  description   String?
  category      String
  priceJmd      Decimal  @map("price_jmd") @db.Decimal(12, 2)
  discountPercent Int    @default(0) @map("discount_percent")
  isFeatured     Boolean  @default(false) @map("is_featured")
  stockQuantity Int      @default(0) @map("stock_quantity")
  // See MasterProduct.imageUrl/images for why both exist.
  imageUrl      String?  @map("image_url")
  images        String[] @default([])
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  shop    Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orders  Order[]
  ratings ProductRating[]

  @@map("shop_products")
}

model StoreListing {
  id              String  @id @default(uuid()) @db.Uuid
  storeId         String  @map("store_id") @db.Uuid
  masterProductId String  @map("master_product_id") @db.Uuid
  retailPriceJmd  Decimal @map("retail_price_jmd") @db.Decimal(12, 2)
  isActive        Boolean @default(true) @map("is_active")

  store         ResellerStore   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  masterProduct MasterProduct   @relation(fields: [masterProductId], references: [id], onDelete: Cascade)
  orders        Order[]
  ratings       ProductRating[]

  // NOTE: the CHECK (retail_price_jmd > wholesale_price_jmd) constraint from the
  // spec can't reference another table's column in Postgres — enforce it in a
  // trigger (see prisma/migrations .../migration.sql) and again in the service layer.

  // A reseller "adds" a master product to their store at most once — re-adding
  // is a no-op / reactivation, not a duplicate row (see commerce.routes.ts).
  @@unique([storeId, masterProductId])
  @@map("store_listings")
}

// ─────────────────────────────────────────────────────────────────────────
// 4d. DELIVERY APPLICATIONS
// A driver requests to become a regular courier for a specific warehouse or
// shop. Approval doesn't gate dispatch itself (see dispatch.routes.ts, which
// offers each order to any online nearby driver) — this is the seller's own
// roster of couriers they've vetted and want working their pickups.
// ─────────────────────────────────────────────────────────────────────────

model DeliveryApplication {
  id       String @id @default(uuid()) @db.Uuid
  driverId String @map("driver_id") @db.Uuid

  // Exactly one of these is set, same "exactly one seller side" pattern as
  // Order.resellerStoreId/warehouseId vs. shopId — enforced in the service
  // layer, since Postgres can't express it declaratively here.
  warehouseId String? @map("warehouse_id") @db.Uuid
  shopId      String? @map("shop_id") @db.Uuid

  status      AuthorizationStatus @default(PENDING)
  requestedAt DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  decidedAt   DateTime?           @map("decided_at") @db.Timestamptz

  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  shop      Shop?         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // A driver can only have one active application per warehouse, and
  // separately per shop — re-applying after a rejection updates that same
  // row rather than piling up duplicates (mirrors ResellerAuthorization's
  // @@unique([storeId, warehouseId])). Postgres treats NULL as distinct in a
  // unique index, so each constraint only ever governs the rows where that
  // particular side is actually set.
  @@unique([driverId, warehouseId])
  @@unique([driverId, shopId])
  @@map("delivery_applications")
}

// ─────────────────────────────────────────────────────────────────────────
// 5. ORDERS & DELIVERIES
// ─────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  // Not in the original spec's enum: an order exists (stock is reserved) the
  // moment checkout starts, but it must not enter the warehouse's PACKING
  // queue until the WiPay webhook confirms payment. Without this state an
  // unpaid order is indistinguishable from a paid one.
  AWAITING_PAYMENT
  PACKING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
}

model Order {
  id              String  @id @default(uuid()) @db.Uuid
  customerId      String  @map("customer_id") @db.Uuid
  // Exactly one seller side is set, enforced in the service layer (Postgres
  // can't express "these two nullable FKs are set together, xor this third"
  // as a declarative Prisma constraint):
  //  - AFFILIATE order: resellerStoreId + warehouseId both set, shopId null.
  //  - STORE order: shopId set, resellerStoreId + warehouseId both null.
  resellerStoreId String? @map("reseller_store_id") @db.Uuid
  warehouseId     String? @map("warehouse_id") @db.Uuid
  shopId          String? @map("shop_id") @db.Uuid
  driverId        String? @map("driver_id") @db.Uuid

  // Which exact item this order is for — same "exactly one side set" pattern
  // as the seller FKs above. Added so a DELIVERED order can prove a customer
  // actually bought (and can now rate) a specific product; earlier orders
  // predate this and simply have both null (never rateable).
  storeListingId String? @map("store_listing_id") @db.Uuid
  shopProductId  String? @map("shop_product_id") @db.Uuid
  quantity       Int     @default(1)

  totalPaidJmd          Decimal @map("total_paid_jmd") @db.Decimal(12, 2)
  // Zero for STORE orders — there's no separate wholesale leg, the shop
  // keeps the whole item price via resellerMarginJmd (see ledger.service.ts).
  wholesaleTotalJmd     Decimal @map("wholesale_total_jmd") @db.Decimal(12, 2)
  // The seller's take: an affiliate's margin above wholesale, OR — for a
  // STORE order — the shop's full item revenue.
  resellerMarginJmd     Decimal @map("reseller_margin_jmd") @db.Decimal(12, 2)
  driverFeeJmd          Decimal @map("driver_fee_jmd") @db.Decimal(12, 2)
  platformCommissionJmd Decimal @map("platform_commission_jmd") @db.Decimal(12, 2)

  status                  OrderStatus @default(AWAITING_PAYMENT)
  deliveryAddress         String      @map("delivery_address")
  proofOfDeliveryImageUrl String?     @map("proof_of_delivery_image_url")
  wipayTransactionId      String?     @unique @map("wipay_transaction_id")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz

  customer      User                @relation("OrderCustomer", fields: [customerId], references: [id])
  driver        User?               @relation("OrderDriver", fields: [driverId], references: [id])
  resellerStore ResellerStore?      @relation(fields: [resellerStoreId], references: [id])
  warehouse     Warehouse?          @relation(fields: [warehouseId], references: [id])
  shop          Shop?               @relation(fields: [shopId], references: [id])
  storeListing  StoreListing?       @relation(fields: [storeListingId], references: [id])
  shopProduct   ShopProduct?        @relation(fields: [shopProductId], references: [id])
  ledgerTxns    LedgerTransaction[]
  // At most one — the orderId unique constraint on ProductRating makes this
  // a true 1:1, not a list (see that model for why: one rating per purchase).
  rating        ProductRating?

  @@map("orders")
}

// ─────────────────────────────────────────────────────────────────────────
// 5b. PRODUCT RATINGS
// A customer can only rate an item once they've actually received it — the
// gate is a DELIVERED order that references this exact listing (see
// ratings.routes.ts). Keyed to the order (not just customer+listing) so
// buying the same item twice earns two ratings, one per purchase.
// ─────────────────────────────────────────────────────────────────────────

model ProductRating {
  id             String   @id @default(uuid()) @db.Uuid
  customerId     String   @map("customer_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  // Exactly one of these is set, mirroring Order.storeListingId/shopProductId
  // — whichever one the qualifying order was for.
  storeListingId String?  @map("store_listing_id") @db.Uuid
  shopProductId  String?  @map("shop_product_id") @db.Uuid
  rating         Int
  // The written half of "feedback" — optional, a buyer can leave just stars.
  // Visible to whichever seller(s) the purchase belongs to: an AFFILIATE
  // order's feedback goes to both the warehouse (via storeListing.masterProduct)
  // and the reseller (via storeListing.storeId); a STORE order's goes only to
  // that shop (via shopProduct.shopId) — see warehouse/shop/commerce routes'
  // GET .../feedback endpoints.
  comment        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeListing StoreListing? @relation(fields: [storeListingId], references: [id], onDelete: Cascade)
  shopProduct  ShopProduct?  @relation(fields: [shopProductId], references: [id], onDelete: Cascade)

  @@map("product_ratings")
}

// ─────────────────────────────────────────────────────────────────────────
// 6. FINANCIAL LEDGER ACCOUNTS & AUDIT TRAIL
// ─────────────────────────────────────────────────────────────────────────

enum LedgerAccountType {
  WAREHOUSE
  RESELLER
  STORE
  DRIVER
  PLATFORM
}

enum EscrowStatus {
  HELD_IN_ESCROW
  DISBURSED_TO_BANK
}

model LedgerAccount {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String?           @map("user_id") @db.Uuid
  accountType         LedgerAccountType @map("account_type")
  bankName            String?           @map("bank_name")
  accountNumber       String?           @map("account_number")
  pendingBalanceJmd   Decimal           @default(0.00) @map("pending_balance_jmd") @db.Decimal(12, 2)
  availableBalanceJmd Decimal           @default(0.00) @map("available_balance_jmd") @db.Decimal(12, 2)

  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LedgerTransaction[]

  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                 String       @id @default(uuid()) @db.Uuid
  orderId            String       @map("order_id") @db.Uuid
  recipientAccountId String       @map("recipient_account_id") @db.Uuid
  amountJmd          Decimal      @map("amount_jmd") @db.Decimal(12, 2)
  escrowState        EscrowStatus @default(HELD_IN_ESCROW) @map("escrow_state")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  order            Order         @relation(fields: [orderId], references: [id])
  recipientAccount LedgerAccount @relation(fields: [recipientAccountId], references: [id])

  // Idempotency: one ledger entry per (order, recipient) leg — prevents duplicate
  // webhook deliveries from double-crediting an account.
  @@unique([orderId, recipientAccountId])
  @@map("ledger_transactions")
}
