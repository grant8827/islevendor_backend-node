# Server
# NOTE: 5000 is taken by macOS ControlCenter (AirPlay Receiver) on this
# machine — using 4000 to avoid the conflict.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Postgres + PostGIS, via docker-compose)
DATABASE_URL="postgresql://postgres:aciuEuyQljECpIHYSFLaYepbYRkGUmTB@postgres.railway.internal:5432/railway"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# WiPay (Jamaica) — sandbox credentials, fill in when available
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENV="sandbox"

# FastAPI AI service
AI_SERVICE_URL="http://localhost:8001"
