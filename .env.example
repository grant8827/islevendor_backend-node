# Server
# NOTE: 5000 is taken by macOS ControlCenter (AirPlay Receiver) on this
# machine — using 4000 to avoid the conflict.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Postgres + PostGIS, via docker-compose)
DATABASE_URL="postgresql://islevendor:islevendor_dev@localhost:5432/islevendor?schema=public"
DATABASE_ENVIRONMENT="development"
# Only isolated remote staging databases may opt in. Never use this to point
# a development process at production.
ALLOW_REMOTE_DATABASE="false"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# WiPay (Jamaica) — sandbox credentials, fill in when available
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENV="sandbox"

# Containment controls. Keep disabled until the corresponding security and
# financial-integrity ticket has passed automated tests and review.
ENABLE_WIPAY_WEBHOOKS="false"
ENABLE_WITHDRAWALS="false"
ENABLE_INTERNAL_REFUNDS="false"
ENABLE_ESCROW_RELEASE="false"

# Local product-media compatibility only. Keep false anywhere this directory
# may contain legacy KYC files.
SERVE_PUBLIC_UPLOADS="false"

# FastAPI AI service
AI_SERVICE_URL="http://localhost:8001"
