# Server
# NOTE: 5000 is taken by macOS ControlCenter (AirPlay Receiver) on this
# machine — using 4000 to avoid the conflict.
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Postgres + PostGIS, via docker-compose)
DATABASE_URL="postgresql://islevendor:islevendor_dev@localhost:5432/islevendor?schema=public"
DATABASE_ENVIRONMENT="development"
# Only isolated remote staging databases may opt in. Never use this to point
# a development process at production.
ALLOW_REMOTE_DATABASE="false"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"

# WiPay (Jamaica) — sandbox credentials, fill in when available
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENV="sandbox"
# Hosted checkout. Leave the URL blank in sandbox to use WiPay's public
# sandbox; live is https://jm.wipayfinancial.com/plugins/payments/request.
WIPAY_PAYMENT_URL=
# Where WiPay sends customers back: this API's /api/webhooks/wipay.
WIPAY_RESPONSE_URL=
WIPAY_FEE_STRUCTURE="merchant_absorb"
WIPAY_COUNTRY_CODE="JM"
WIPAY_CURRENCY="JMD"
WIPAY_ORIGIN="IsleVendor"
# Optional: signing secret of a Payments API webhook registered at
# /api/webhooks/wipay (catches customers who never return to the site).
WIPAY_WEBHOOK_SECRET=
# The marketplace website; customers land on /payment/<id> after paying.
PUBLIC_WEB_URL=http://localhost:5173

# Payout details encryption: openssl rand -base64 32
PAYOUT_DATA_KEY=
# Automated payouts through WiPay's withdrawal API — see docs/wipay/.
ENABLE_AUTOMATED_PAYOUTS="false"
WIPAY_PAYOUT_API_URL=
WIPAY_PAYOUT_API_KEY=
WIPAY_PAYOUT_WEBHOOK_SECRET=
WIPAY_PAYOUTS_LIVE_AUTHORIZED="false"

# IsleVendor Pay (the Java payment service in islevendor-pay/).
# "node" (default): this backend takes card payments, as before.
# "islevendor-pay": new checkouts are handed to IsleVendor Pay; it reports
# outcomes to POST /internal/pay/payments/:id/outcome.
PAYMENTS_PROVIDER="node"
ISLEVENDOR_PAY_INTERNAL_URL=""
# At least 32 random characters (openssl rand -base64 48); the same value in both services.
ISLEVENDOR_PAY_SERVICE_TOKEN=""

# Containment controls. Keep disabled until the corresponding security and
# financial-integrity ticket has passed automated tests and review.
ENABLE_WIPAY_WEBHOOKS="false"
ENABLE_WITHDRAWALS="false"
ENABLE_INTERNAL_REFUNDS="false"
ENABLE_ESCROW_RELEASE="false"

# Local product-media compatibility only. Keep false anywhere this directory
# may contain legacy KYC files.
SERVE_PUBLIC_UPLOADS="false"

# FastAPI AI service
AI_SERVICE_URL="http://localhost:8001"
